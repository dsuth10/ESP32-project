# ==============================================================================
# ESP32 & Windows Compose / Dictate Companion Configuration Template
# Copy this file to compose.env and customize as desired.
# ==============================================================================

# --- Speech-to-Text (STT) Settings ---
# Primary cloud provider: Groq Whisper + Groq LLM (home-speed path).
# If this is empty, the companion also reads GROQ_API_KEY from
# %LOCALAPPDATA%\hermes\.env and server/.env. Local Whisper/Ollama are
# fallbacks only when Groq is missing or the network blocks it.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3-turbo

# Local faster-whisper fallback settings
LOCAL_WHISPER_MODEL=base
# auto = CUDA only when cuBLAS loads; otherwise CPU. A broken GPU stack
# used to abort the companion window. Set cpu to skip the GPU check.
LOCAL_WHISPER_DEVICE=auto

# --- LLM Generation Settings ---
# Primary cloud LLM for Compose mode.
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Embedded assistant (Ask / Manage). Blank uses GROQ_LLM_MODEL.
# Management needs a model that supports local tool/function calling.
GROQ_ASSISTANT_MODEL=

# Retain new text requests/responses on this Windows account (no raw audio).
# Turn off for sessions where you do not want a persistent writing history.
HISTORY_ENABLED=1

# Local Ollama fallback settings (used when offline, on error, or LOCAL_ONLY=1)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# Set to 1 to force 100% offline local processing (useful in school/work/travel).
# If this stays 0 and the school network blocks Groq, the first request falls back
# to local Whisper and Ollama, and later requests stay local for that session.
LOCAL_ONLY=0

# --- Audio Capture Settings ---
# Audio device index or name (leave blank to use Windows default communications mic)
AUDIO_INPUT_DEVICE=
AUDIO_SAMPLE_RATE=16000

# --- Clipboard & Injection Settings ---
# Delay in seconds to allow target app to swallow Ctrl+V before restoring clipboard
CLIPBOARD_RESTORE_DELAY=0.15

# Maximum automatic multi-turn continuations for long generations
CONTINUATION_MAX_ROUNDS=4

# --- Live Web Search Grounding (Brave Search) ---
# Set to 1 to enable live web retrieval for time-sensitive compose requests
WEB_SEARCH_ENABLED=1
# Brave Search API Key (from https://brave.com/search/api/)
BRAVE_API_KEY=
BRAVE_COUNTRY=AU
BRAVE_RESULT_COUNT=5

# --- Fast Intent Router Settings ---
# Mode: auto (keywords -> Jev -> Groq), keywords, jev, groq, always, off
INTENT_ROUTER=auto

# OpenRouter Decisions API (Type 1 model: ~typesafe/jev-latest)
# (Optional: if empty or offline, falls back to ROUTER_GROQ_MODEL)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai
JEV_MODEL=~typesafe/jev-latest

# Fast fallback router model on Groq (~100-300ms)
ROUTER_GROQ_MODEL=openai/gpt-oss-20b

# --- Image feature preview (settings can also be entered in the desktop UI) ---
# Keep both off while the production companion is running. Relaunch after changing.
ESP32_ENABLE_HOTKEYS=0
ESP32_START_RECEIVER=0
# Optional attached-device display feedback. Configure only the explicitly
# verified port and registered S3 base identity (12 lowercase hex digits).
# DEVICE_FEEDBACK_ID is private; the desktop protects it with Windows DPAPI.
DEVICE_FEEDBACK_PORT=
DEVICE_FEEDBACK_ID=
MEDIA_SYNC_ENABLED=0
MEDIA_SERVER_URL=
MEDIA_SERVER_TOKEN=
# Optional private Hermes task panel. Credentials are stored separately with Windows DPAPI in the desktop app.
HERMES_ENABLED=0
HERMES_URL=
# Enter the Hermes token in the desktop Settings panel; it is stored with Windows DPAPI.
# Paid requests remain disabled until credentials, shared budget and allocation are configured.
IMAGE_GENERATION_ENABLED=0
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2.5-sunburst
# Existing installations keep OpenAI. Select Google explicitly in desktop Settings.
IMAGE_PROVIDER=openai
GOOGLE_IMAGE_MODEL=gemini-nano-banana-2.1
# Enter the Google image API key in Settings; it is protected with Windows DPAPI.
GOOGLE_IMAGE_SIZE=1K
GOOGLE_IMAGE_ASPECT_RATIO=1:1
GOOGLE_IMAGE_THINKING=medium
# Set conservative allocations separately for the supported Google model/resolution.
# No default cost estimate or paid trial is approved by these settings.
GOOGLE_IMAGE_ESTIMATE_1K_AUD_CENTS=
GOOGLE_IMAGE_ESTIMATE_2K_AUD_CENTS=
GOOGLE_IMAGE_ESTIMATE_4K_AUD_CENTS=
# Conservative AUD cents per attempt; no automatic FX/invoice calculation.
IMAGE_ESTIMATE_AUD_CENTS=
