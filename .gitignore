# PlatformIO build directory and environments
.pio/
.pioenvs/
.piolibdeps/

# Sensitive Configuration & Credentials
*wifi_config.h
!*wifi_config.h.example

# Python cache & virtual environments
__pycache__/
*.pyc
*.pyo
venv/
.env
tools/compose/*.env
!tools/compose/compose.env.example
tools/compose/*.log
