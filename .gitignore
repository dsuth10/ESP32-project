server/bench_results/

# Editor and IDE configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# Golden landscape firmware archives (local restore only)
bin/golden-landscape-*/
