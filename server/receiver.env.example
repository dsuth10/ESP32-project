# Hermes Voice Satellite Receiver Configuration
# Copy this file to .env or ~/.hermes/.env to configure the receiver service.

# Network listener settings
RECEIVER_PORT=8787
RECEIVER_HOST=0.0.0.0
# Environment mode: 'home' (normal Linux host) or 'work' (school/hotspot Windows host)
RECEIVER_ENV=work

# Voice Receiver Authentication (Phase 20)
# Optional shared bearer secret between ESP32 and this receiver.
# Separate from Hermes API_SERVER_KEY to maintain security isolation.
VOICE_RECEIVER_TOKEN=your_receiver_bearer_token_here

# Persistent Hermes Gateway (Primary Path)
# Hermes officially runs an API server on 127.0.0.1:8642
HERMES_GATEWAY_URL=http://127.0.0.1:8642/v1/chat/completions
# API_SERVER_KEY must match the key configured in Hermes
API_SERVER_KEY=your_hermes_api_server_key_here

# Local Ollama Settings (Used at Work/School for private local GPU inference)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:latest
# Keep model in GPU VRAM (e.g. '8h' for school/work day, or '-1' for indefinite)
OLLAMA_KEEP_ALIVE=8h
# Token budget for local Ollama and the Groq fast lane
OLLAMA_NUM_PREDICT=120

# Hybrid fast lane (opt-in). off = legacy order (work: Ollama then Hermes, home: Hermes then Ollama).
# groq = chat questions go to Groq; tool/action/live-data requests go to the Hermes agent.
# ollama = same router, but the fast lane is local Ollama.
FAST_LLM_PROVIDER=groq
FAST_LLM_MODEL=qwen/qwen3.8-27b
FAST_LLM_MAX_TOKENS=120
FAST_LLM_TIMEOUT_S=8
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Hermes agent lane (used when the router detects tools / live data / device actions)
HERMES_AGENT_TIMEOUT_S=25
HERMES_REASONING_EFFORT=low
HERMES_VOICE_PROVIDER=custom:groq-voice
HERMES_VOICE_MODEL=openai/gpt-oss-20b

# Speech-to-text: local faster-whisper base, or groq (whisper-large-v3-turbo, local fallback)
STT_PROVIDER=local
GROQ_STT_MODEL=whisper-large-v3-turbo

# Telegram Notification Mirroring (Optional)
# Note: Automatically suppressed when RECEIVER_ENV=work for local privacy hardening
DISABLE_TELEGRAM=0
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Local Voice Synthesis / TTS (Voicebox)
ENABLE_TTS=1
VOICEBOX_URL=http://127.0.0.1:17493
# Engine: 'kokoro' (ultra-fast 82M, ~0.3s) or 'qwen' (high-fidelity cloned voice, ~15-45s)
VOICEBOX_ENGINE=kokoro
# Preset profiles: 'Kokoro Michael', 'Kokoro George', 'Kokoro Adam', 'Kokoro Heart', or custom 'Doug's Best Voice'
VOICEBOX_PROFILE_NAME=Kokoro Heart
VOICEBOX_MODEL_SIZE=1.7B
# Maximum characters sent to TTS before clean sentence trimming (default 260)
TTS_MAX_CHARS=260
# Speak LLM replies out loud on host computer speakers (1 = enabled, 0 = disabled)
SPEAK_ON_HOST=1

