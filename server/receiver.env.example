# Hermes Voice Satellite Receiver Configuration
# Copy this file to .env or ~/.hermes/.env to configure the receiver service.

# Network listener settings
RECEIVER_PORT=8787
RECEIVER_HOST=0.0.0.0
# Environment mode: 'home' (normal Linux host) or 'work' (school/hotspot Windows host)
RECEIVER_ENV=work

# Voice Receiver Authentication (Phase 20)
# Optional shared bearer secret between ESP32 and this receiver.
# Separate from Hermes API_SERVER_KEY to maintain security isolation.
VOICE_RECEIVER_TOKEN=your_receiver_bearer_token_here

# Persistent Hermes Gateway (Primary Path)
# Hermes officially runs an API server on 127.0.0.1:8642
HERMES_GATEWAY_URL=http://127.0.0.1:8642/v1/chat/completions
# API_SERVER_KEY must match the key configured in Hermes
API_SERVER_KEY=your_hermes_api_server_key_here

# Local Ollama Settings (Used at Work/School for private local GPU inference)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:latest
# Keep model in GPU VRAM (e.g. '8h' for school/work day, or '-1' for indefinite)
OLLAMA_KEEP_ALIVE=8h

# Telegram Notification Mirroring (Optional)
# Note: Automatically suppressed when RECEIVER_ENV=work for local privacy hardening
DISABLE_TELEGRAM=0
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Local Voice Synthesis / TTS (Voicebox)
ENABLE_TTS=1
VOICEBOX_URL=http://127.0.0.1:17493
VOICEBOX_PROFILE_NAME=Doug's Best Voice
VOICEBOX_MODEL_SIZE=1.7B

