# Hermes Voice Satellite Receiver Configuration
# Copy this file to .env or ~/.hermes/.env to configure the receiver service.

# Network listener settings
RECEIVER_PORT=8787
RECEIVER_HOST=0.0.0.0

# Persistent Hermes Gateway (Primary Path)
# Hermes officially runs an API server on 127.0.0.1:8642
HERMES_GATEWAY_URL=http://127.0.0.1:8642/v1/chat/completions
# API_SERVER_KEY must match the key configured in Hermes
API_SERVER_KEY=your_hermes_api_server_key_here

# Local Ollama Fallback Settings (Used at Work/School if Hermes is down or starting up)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:latest

# Telegram Notification Mirroring (Optional)
# Set DISABLE_TELEGRAM=1 to keep all voice traffic strictly local/private
DISABLE_TELEGRAM=0
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
